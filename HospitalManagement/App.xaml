<Application
    x:Class="HospitalManagement.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- WinUI controls resources (required for WinUI controls styling) -->
        <controls:XamlControlsResources />

        <!-- Merge ERManagementSystem styles that define CardBorderStyle.
             Adjust the Source URI to the actual path/assembly where your styles live. -->
		  <ResourceDictionary Source="ms-appx:///ERManagementSystem/Styles/Controls.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>