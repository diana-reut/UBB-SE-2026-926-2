<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HospitalManagement.Web</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HospitalManagement.Web.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        bool hideShell = ViewData["HideShell"] as bool? ?? false;
        string? currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        bool isArchiveView = string.Equals(currentController, "Admin", StringComparison.OrdinalIgnoreCase)
            && string.Equals(Context.Request.Query["archived"], "true", StringComparison.OrdinalIgnoreCase);
        string? currentModule = Context.Request.Query["id"];
        string? username = User.Identity?.Name;
        string? role = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value;
    }
    @if (hideShell)
    {
        <main role="main" class="container py-5">
            @RenderBody()
        </main>
    }
    else
    {
        <div class="app-shell">
            <aside class="app-sidebar">
                <div>
                    <a class="app-brand" asp-area="" asp-controller="Home" asp-action="Index">HospitalManagement</a>
                    <nav class="nav flex-column app-nav">
                        <a class="app-nav-link @(string.Equals(currentController, "Admin", StringComparison.OrdinalIgnoreCase) && !isArchiveView ? "active" : string.Empty)"
                           asp-area=""
                           asp-controller="Admin"
                           asp-action="Index">
                            Admin Dashboard
                        </a>
                        <a class="app-nav-link @(string.Equals(currentController, "Modules", StringComparison.OrdinalIgnoreCase) && string.Equals(currentModule, "medical-staff", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)"
                           asp-area=""
                           asp-controller="Modules"
                           asp-action="Index"
                           asp-route-id="medical-staff">
                            Medical Staff
                        </a>
                        <a class="app-nav-link @(string.Equals(currentController, "Pharmacist", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)"
                           asp-area=""
                           asp-controller="Pharmacist"
                           asp-action="Prescriptions">
                            Pharmacy
                        </a>
                        <div class="app-nav-separator"></div>
                        <a class="app-nav-link @(string.Equals(currentController, "Modules", StringComparison.OrdinalIgnoreCase) && string.Equals(currentModule, "patient-registration", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)"
                           asp-area=""
                           asp-controller="Modules"
                           asp-action="Index"
                           asp-route-id="patient-registration">
                            Patient Registration
                        </a>
                        <a class="app-nav-link @(string.Equals(currentController, "Modules", StringComparison.OrdinalIgnoreCase) && string.Equals(currentModule, "queue", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)"
                           asp-area=""
                           asp-controller="Modules"
                           asp-action="Index"
                           asp-route-id="queue">
                            Queue
                        </a>
                        <a class="app-nav-link @(string.Equals(currentController, "Modules", StringComparison.OrdinalIgnoreCase) && string.Equals(currentModule, "triage", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)"
                           asp-area=""
                           asp-controller="Modules"
                           asp-action="Index"
                           asp-route-id="triage">
                            Triage
                        </a>
                        <a class="app-nav-link @(string.Equals(currentController, "Modules", StringComparison.OrdinalIgnoreCase) && string.Equals(currentModule, "room-assignment", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)"
                           asp-area=""
                           asp-controller="Modules"
                           asp-action="Index"
                           asp-route-id="room-assignment">
                            Room Assignment
                        </a>
                        <a class="app-nav-link @(string.Equals(currentController, "Modules", StringComparison.OrdinalIgnoreCase) && string.Equals(currentModule, "examination", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)"
                           asp-area=""
                           asp-controller="Modules"
                           asp-action="Index"
                           asp-route-id="examination">
                            Examination
                        </a>
                        <a class="app-nav-link @(string.Equals(currentController, "Modules", StringComparison.OrdinalIgnoreCase) && string.Equals(currentModule, "transfer-log", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)"
                           asp-area=""
                           asp-controller="Modules"
                           asp-action="Index"
                           asp-route-id="transfer-log">
                            Transfer Log
                        </a>
                        <a class="app-nav-link @(string.Equals(currentController, "Modules", StringComparison.OrdinalIgnoreCase) && string.Equals(currentModule, "room-management", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)"
                           asp-area=""
                           asp-controller="Modules"
                           asp-action="Index"
                           asp-route-id="room-management">
                            Room Management
                        </a>
                    </nav>
                </div>

                <div class="app-sidebar-footer">
                    @if (!string.IsNullOrWhiteSpace(username))
                    {
                        <div class="mb-2">@username (@role)</div>
                        <form asp-controller="Authentication" asp-action="Logout" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-light w-100">Sign out</button>
                        </form>
                    }
                    else
                    {
                        <span>926/2</span>
                    }
                </div>
            </aside>

            <main role="main" class="app-content">
                @RenderBody()
            </main>
        </div>
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
